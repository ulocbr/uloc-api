{
  "name": "ulocbr/uloc-api",
  "description": "A powerful API with the basics that every web application needs",
  "type": "symfony-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "Tiago Felipe",
      "email": "tiago@tiagofelipe.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "symfony/config": "^7.0",
    "symfony/dependency-injection": "^7.0",
    "symfony/http-kernel": "^7.0",
    "lcobucci/jwt": "^5.4",
    "namshi/jose": "^7.2",
    "symfony/security-bundle": "^7.0",
    "doctrine/doctrine-bundle": "^2.15",
    "symfony/form": "^7.0",
    "symfony/event-dispatcher": "^7.0",
    "symfony/validator": "^7.0",
    "symfony/cache": "^7.0",
    "symfony/mailer": "^7.0",
    "symfony/messenger": "^7.0",
    "twig/twig": "^3.2",
    "psr/clock": "^1.0",
    "lcobucci/clock": "^3.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "symfony/phpunit-bridge": "^7.0",
    "symfony/browser-kit": "^7.0",
    "symfony/console": "^7.0",
    "symfony/dom-crawler": "^7.0",
    "symfony/var-dumper": "^7.0",
    "symfony/yaml": "^7.0",
    "doctrine/doctrine-fixtures-bundle": "^3.3",
    "guzzlehttp/guzzle": "^7.8"
  },
  "autoload": {
    "psr-4": {
      "Uloc\\ApiBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Uloc\\ApiBundle\\Tests\\": "tests/"
    }
  }
}
